import Quickshell
import QtQuick
import qs.services
import qs.modules

// Layout:
//   theme/                 Style.qml, Colors.qml (Colors is generated by matugen)
//   services/              one singleton per thing: state, actions, IPC
//   modules/               windows: read services, hold no logic
ShellRoot {
    // Singletons start the first time something uses them. These must run even
    // when no window shows them (notification daemon, battery warnings,
    // wallpaper and overlay IPC), so touch them once here.
    readonly property var alwaysOn: [Notifs, Battery, Wall, Panels]

    Wallpaper {}
    Bar {}
    Launcher {}
    Notifications {}
    Osd {}
    MusicCard {}
    Cheatsheet {}
    PowerMenu {}
    WallpaperPicker {}
    Lock {}
}
